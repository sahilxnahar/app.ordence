# ==============================================================================
# Ordence — TEST environment (v0.6.0-alpha)
# ------------------------------------------------------------------------------
#  ⚠️  READ THIS BEFORE FILLING IT IN
#
#  The security test suite CREATES tenants, INSERTS rows, and DELETES everything
#  it made. If it ever pointed at your real database, it would destroy live
#  customer data.
#
#  So: point this at a THROWAWAY database. Never your production one.
#
#  Copy this file:   cp .env.test.example .env.test
#  Then edit .env.test — it is already in .gitignore and will never be committed.
# ==============================================================================

# ---------- THE TEST DATABASE ----------
# Note the variable NAME: TEST_DATABASE_URL, not DATABASE_URL.
# That difference is deliberate — pasting your production string here under the
# wrong name would simply not be read.
#
# The URL must contain one of: localhost, 127.0.0.1, test, _test
# Otherwise the suite refuses to start.
#
# OPTION A — Neon branch (recommended, free)
#   In Neon: your project -> Branches -> "Create branch" -> name it `test`
#   Then create a database called `ameya_test` inside it and use that string:
TEST_DATABASE_URL="postgresql://user:password@ep-xxxx.region.aws.neon.tech/ameya_test?sslmode=require"

# OPTION B — Local Postgres (if you have it installed)
# TEST_DATABASE_URL="postgresql://postgres@localhost:5432/ameya_test"


# ---------- SAFETY ACKNOWLEDGEMENT ----------
# The suite will not run without this. It has to be typed by a person —
# that is the whole point of it existing.
ALLOW_DESTRUCTIVE_TESTS="true"


# ---------- OPTIONAL ----------
NODE_ENV="test"
