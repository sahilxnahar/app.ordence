/.open-next/
.wrangler/

# Local Workers secrets — NEVER commit. Holds real database and Clerk keys
# for `wrangler dev`, which reads it automatically.
.dev.vars
.dev.vars.*

# Vitest JUnit output — generated, never committed.
test-results/

# Wrangler / miniflare LOCAL state — v0.73.0-alpha
#
# ⚠️ 12 files of miniflare cache (metadata.sqlite, -wal, -shm for
# CacheObject, R2BucketObject and the observability trace store) were
# being committed. They are a local dev artifact of `wrangler dev`, they
# differ per machine, and they are pure noise in a diff.
.wrangler/
