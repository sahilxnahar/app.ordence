{
  "name": "ordence",
  "version": "1.22.0-alpha",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "preflight": "node scripts/preflight.mjs",
    "preflight:full": "node scripts/preflight.mjs --full",
    "check:boundaries": "node scripts/check-server-boundaries.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:rls": "node scripts/check-rls-coverage.mjs",
    "db:status": "node scripts/neon-status.mjs",
    "release": "bash scripts/make-release.sh",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "node -e \"if(process.env.NODE_ENV==='production'){console.error('\\\\n\\u26d4 drizzle-kit push is FORBIDDEN in this project: it drops RLS policies on 160 tables. Use the numbered SQL-FILES/ instead.\\\\n');process.exit(1)}\" && drizzle-kit push && echo '\\n\u26a0\ufe0f  drizzle-kit push DROPS RLS POLICIES. Now run SQL-FILES/ALL-IN-ONE-SETUP.sql, then: npm run db:verify\\n'",
    "db:studio": "drizzle-kit studio",
    "security:audit": "npm audit --audit-level=moderate",
    "seed": "tsx scripts/seed-basaveshwar-project.ts",
    "seed:phase5": "tsx scripts/seed-phase5.ts",
    "seed:plans": "tsx scripts/seed-plans.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:security": "vitest run --project=security",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest run --project=ui",
    "test:all": "vitest run",
    "db:verify": "tsx scripts/verify-security.ts",
    "drill:restore": "tsx scripts/restore-drill.ts",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "deploy": "node -e \"console.error('\\n\\u26d4 Ordence deploys from GitHub to Railway.\\n   Commit and push in GitHub Desktop. Railway builds automatically.\\n   (The old Cloudflare command is still available as: npm run cf:deploy)\\n'); process.exit(1)\"",
    "seed:contracting": "tsx scripts/seed-contracting-demo.ts",
    "check:sql": "node scripts/check-sql-completeness.mjs",
    "check:posting": "node scripts/check-posting-coverage.mjs",
    "check:reachability": "node scripts/check-reachability.mjs"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.39.6",
    "@hookform/resolvers": "^3.10.0",
    "@neondatabase/serverless": "^0.10.4",
    "@radix-ui/react-alert-dialog": "^1.1.23",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.15",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@sentry/nextjs": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.9",
    "@upstash/qstash": "^2.11.3",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.3",
    "@vercel/blob": "^2.6.1",
    "aws4fetch": "^1.0.20",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^0.469.0",
    "next": "^15.5.22",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.83.0",
    "recharts": "^2.15.4",
    "resend": "^6.18.1",
    "sonner": "^1.7.4",
    "svix": "^1.99.1",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^22.10.5",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-v8": "^3.2.7",
    "autoprefixer": "^10.4.20",
    "dotenv": "^16.6.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-next": "^16.2.12",
    "jsdom": "^25.0.1",
    "pg": "^8.22.0",
    "postcss": "^8.5.25",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.23.1",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7",
    "wrangler": "^4.118.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "overrides": {
    "nanoid": "^3.3.17"
  }
}
