# ==============================================================================
# Ordence — Environment Variables (v0.1.0-alpha)
# ------------------------------------------------------------------------------
# Copy this file to `.env.local` for local development.
# NEVER commit `.env.local` — it is already in .gitignore.
#
# Variables starting with NEXT_PUBLIC_ are visible in the browser.
# Everything else is server-only and must stay secret.
# ==============================================================================

# ---------- APPLICATION ----------
# Full URL of your app. Locally this is http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# The domain tenants live under. Locally: localhost:3000
# In production: your real domain, e.g. app.ordence.com
NEXT_PUBLIC_ROOT_DOMAIN="localhost:3000"


# ---------- DATABASE (Neon Postgres) ----------
# Get from: Neon dashboard -> your project -> Connection Details
# Use the POOLED connection string (it contains "-pooler").
DATABASE_URL="postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/dbname?sslmode=require"

# The DIRECT (non-pooled) string — same page, toggle off "Pooled connection".
# Used only when running database migrations.
DATABASE_URL_UNPOOLED="postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require"


# ---------- AUTHENTICATION (Clerk) ----------
# Get from: Clerk dashboard -> API Keys
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_xxxxxxxxxxxxxxxxxxxx"
CLERK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxx"

# Clerk webhook secret. Clerk dashboard -> Webhooks -> your endpoint -> Signing Secret
# Needed in Phase 2 for automatic tenant provisioning. Leave blank for now.
CLERK_WEBHOOK_SIGNING_SECRET=""

# Where Clerk sends users. Leave these as-is.
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/sign-in"
NEXT_PUBLIC_CLERK_SIGN_UP_URL="/sign-up"


# ---------- CACHE & RATE LIMITING (Upstash Redis) ----------
# Get from: Upstash console -> your database -> REST API section
# OPTIONAL in Phase 1 — the app runs without it, just without caching.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""


# ---------- PLATFORM ----------
# Comma-separated emails granted platform-staff access. Put your own email here.
PLATFORM_ADMIN_EMAILS="you@example.com"

# ======================================================================
# ⭐ THE REST OF IT — added v0.73.0-alpha (Batch 3)
# ======================================================================
# 🔴 This file used to document 12 of 43 variables.
#
# Copying it gave you a working local app with no storage, no payments,
# no email and no tax identity — and no hint that any of those existed.
# The authoritative list is the Zod schema in `lib/env.ts`; this file now
# mirrors it.
#
# NOTHING BELOW IS REQUIRED TO BOOT. Only DATABASE_URL, CLERK_SECRET_KEY
# and NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY are. Everything else degrades
# with a clear message rather than crashing — which is deliberate, and
# which is also why a missing one is invisible until you use the feature.
# `GET /api/diag` tells you what is actually configured.
# ======================================================================

# --- Object storage (Cloudflare R2 over the S3 API) -------------------
# ⚠️ S3_ENDPOINT MUST NOT CONTAIN THE BUCKET NAME. The code appends
#    /<bucket>/<key> itself. Cloudflare's dashboard shows the bucket in
#    the "S3 API" string; stop at .com.
# ⚠️ ALL FOUR OR NONE. readS3Config() returns null if one is missing, and
#    the document vault degrades to "storage is not configured".
S3_ENDPOINT="https://<account-id>.r2.cloudflarestorage.com"
S3_BUCKET="ordence-documents"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""

# --- Secrets that make features work ----------------------------------
# ⚠️ WITHOUT THIS, EVERY FILE UPLOAD REFUSES. Minimum 32 characters.
UPLOAD_TICKET_SECRET=""
# ⚠️ WITHOUT THIS, /api/workers RETURNS 503 AND ALL BACKGROUND JOBS STOP.
WORKER_API_SECRET=""
# Run queued jobs in-process. The stopgap until a cron service exists.
ORDENCE_INLINE_JOBS="1"

# --- Queue (Upstash QStash) -------------------------------------------
QSTASH_CURRENT_SIGNING_KEY=""
QSTASH_NEXT_SIGNING_KEY=""
# Vercel-cron auth path. Vestigial on Railway.
CRON_SECRET=""

# --- Email (Resend) ---------------------------------------------------
RESEND_API_KEY=""
# Must be on a domain VERIFIED in Resend, or every send is rejected.
RESEND_FROM_EMAIL="Ordence <notifications@mail.ordence.com>"
FINANCE_ALERT_EMAILS=""

# --- Payments ---------------------------------------------------------
# ⚠️ RAZORPAY_KEY_ID is the publishable half but carries NO NEXT_PUBLIC_
#    prefix on purpose — a server action hands it to the client
#    explicitly, so it can never be inlined into the bundle by accident.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# --- Our own tax identity ---------------------------------------------
# ⚠️ Exactly 2 characters. Decides IGST vs CGST+SGST on every invoice.
PLATFORM_GST_STATE_CODE=""
PLATFORM_GSTIN=""
PLATFORM_INVOICE_PREFIX="ORD"
# ⚠️ PRINTED ON EVERY INVOICE. Wrong here is wrong on paper.
PLATFORM_LEGAL_NAME=""
PLATFORM_ADDRESS=""

# --- Hosts ------------------------------------------------------------
# The zone tenant subdomains hang off, e.g. ordence.com
NEXT_PUBLIC_ZONE_DOMAIN="localhost:3000"
# Staff console host. Defaults to admin.<zone>.
PLATFORM_HOST=""

# --- Telemetry --------------------------------------------------------
# ⚠️ Falls back to VERCEL_GIT_COMMIT_SHA, which Railway NEVER SETS — so
#    on Railway, leaving this blank makes every telemetry row read
#    "unknown". Set it to the version you deployed.
TELEMETRY_RELEASE=""
NEXT_PUBLIC_RELEASE=""
# Opt-OUT kill switch. Set to any value to stop telemetry writes.
TELEMETRY_DISABLED=""

# --- Security ---------------------------------------------------------
# Unset = CSP is REPORT-ONLY. Set to "true" only after reviewing the
# violation reports, or you will block your own scripts.
CSP_ENFORCE=""

# --- Safety catches ---------------------------------------------------
# ⚠️ Guards the seed scripts against running on a production database.
#    Leave blank. Setting it is a deliberate act.
SEED_ALLOW_PROD=""

# --- Legacy, kept for the Cloudflare rollback -------------------------
# Vercel Blob. Two deployment pivots stale; no live code path reaches it.
BLOB_READ_WRITE_TOKEN=""

# ======================================================================
# ⭐ AI PROVIDERS — for the AI assistant feature (v0.76.0-alpha)
# ======================================================================
# ALL OPTIONAL. The app runs without any of these. The AI assistant
# features are simply switched off until at least one provider key
# is set. The AI router picks the best available provider automatically.
#
# Get keys (all free tiers, email signup, no card required):
#   Groq:       https://console.groq.com/keys
#   Cerebras:   https://cloud.cerebras.ai/
#   Google AI:  https://aistudio.google.com/app/apikey
#   Mistral:    https://console.mistral.ai/api-keys
#   Cohere:     https://dashboard.cohere.com/api-keys
#   GitHub:     https://github.com/marketplace/models
#   Cloudflare: https://dash.cloudflare.com/profile/api-tokens
#
# CONFIDENTIAL LANE — the only one allowed to see tenant data:
CLOUDFLARE_ACCOUNT_ID=""
CF_AI_TOKEN=""
#
# OPEN LANE — for tasks that don't touch tenant data (drafting, summaries):
GROQ_API_KEY=""
CEREBRAS_API_KEY=""
GOOGLE_AI_API_KEY=""
MISTRAL_API_KEY=""
COHERE_API_KEY=""
GITHUB_MODELS_TOKEN=""

# ---------------------------------------------------------------------
# VAULT — application-level encryption for tenant integration credentials
# ---------------------------------------------------------------------
# 🔴 Absent from every deployment document until v1.32.0, so most
# installations have no vault: `putSecret` refuses and no connector
# credential can be stored. Nothing leaks without it — it fails closed —
# but the feature is dark on arrival and nothing says why.
#
# Generate each one locally, 32 bytes of hex:
#   openssl rand -hex 32
#
# ⚠️ There is no key registry yet, so rotating VAULT_ENCRYPTION_KEY makes
# every existing row permanently unreadable. Set it once and keep it.
VAULT_ENCRYPTION_KEY=""
VAULT_BLIND_INDEX_PEPPER=""

# Where CSP violation reports are collected. Without it the report-only
# phase gathers nothing, so it can never end and CSP_ENFORCE can never
# be turned on with confidence.
CSP_REPORT_URI=""
